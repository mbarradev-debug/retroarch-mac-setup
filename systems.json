{
  "_comment": [
    "System map used by setup.sh. Key = libretro-database system name, which is also the ROM folder name,",
    "the playlist name and the libretro-thumbnails folder name.",
    "esde_names: EmulationStation/ES-DE short folder names that will be proposed for renaming.",
    "cores: ordered list of libretro cores (first = default). Arcade systems may route per game.",
    "dat: libretro-database metadat folder used for CRC identification (no-intro | redump | null).",
    "bios.mode: all = every listed file needed, one_of = at least one, optional = nice to have.",
    "aspect: \"4:3\" = TV console shown at 4:3 (per-folder override); missing = aspect reported by the core.",
    "shader: preset file in config/shaders/ (without extension) or 'none'.",
    "overrides: per-core retroarch.cfg overrides (e.g. glcore fallback when Vulkan/MoltenVK fails).",
    "core_options: option values written to config/<core>/<core>.opt; for systems with several cores use {\"<core>\": {...}}."
  ],
  "systems": {
    "MAME": {
      "esde_names": ["arcade", "mame", "mame-advmame", "mame-libretro"],
      "type": "arcade",
      "cores": ["mame2010", "mame2003_plus"],
      "extensions": ["zip"],
      "dat": null,
      "bios": {"mode": "optional", "files": []},
      "core_options": {"mame2003_plus": {"mame2003-plus_xy_device": "disabled", "mame2003-plus_input_interface": "retropad", "mame2003-plus_mame_remapping": "enabled"}},
      "shader": "crt-arcade"
    },
